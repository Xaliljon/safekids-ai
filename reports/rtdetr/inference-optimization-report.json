    "factor": 4.33,
    "sprint22_p95_over_mean": 3.26,
    "sprint23_p95_over_mean": 1.16,
    "cause": "Sprint 22 launched the benchmark in the background and then ran the full test suite, ruff, mypy and documentation work on the same CPU. The 3.26x p95/mean skew is the signature of contention, not of the model.",
    "also_wrong_in_sprint22": "the 'ONNX is 3.7x slower than PyTorch' finding \u2014 the clean ratio is 1.46x",
    "baseline_not_silently_replaced": true
  },
