# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# --- Dart / Flutter ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
# Apps (mobile, dashboard) commit their pubspec.lock; library packages do not.
packages/dart/**/pubspec.lock
mobile/build/
dashboard/build/
*.iml

# --- Secrets & environment (never commit; see docs/03_ENGINEERING_PRINCIPLES.md) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore

# --- Data (raw datasets never enter git; DVC pointers only) ---
/models/
datasets/**
!datasets/README.md
!datasets/**/*.dvc
!datasets/.gitignore
*.onnx
*.engine
*.pt
*.pth

# --- Colab packaging outputs (scripts/package-*.sh; assets, never source) ---
/guardian-ai.zip
/guardian-dataset-v1.zip

# --- OS / IDE ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Logs / temp ---
*.log
tmp/
